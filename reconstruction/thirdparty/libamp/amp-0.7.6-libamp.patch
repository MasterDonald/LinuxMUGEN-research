+#include <stdlib.h>
+#include <allegro.h>
 #include "amp.h"
 #include "audio.h"
 #include "formats.h"
@@ -236,19 +238,25 @@
 int dummy_getinfo(int n)
 {
 	n-=4;
-        if ( fseek(in_file,n,SEEK_CUR) != 0)
-                if (feof(in_file)) return GETHDR_EOF;
+	/* LibAmp: Allegro PACKFILEs only seek forward (VERIFIED 0x080e4d00) */
+	if (n < 0) abort();
+        if ( pack_fseek(in_file,n) != 0)
+                if (pack_feof(in_file)) return GETHDR_EOF;
                 else return GETHDR_ERR;
 	return 0;
 }
 
 int rewind_stream(int nbytes)
 {
+	/* LibAmp: a backward seek is impossible on a PACKFILE; the binary
+	 * aborts for every non-negative nbytes (VERIFIED 0x080e4d60). */
 	nbytes+=5;
-	if (fseek(in_file, -nbytes, SEEK_CUR) != 0) {
+	if (-nbytes < 0) abort();
+	if (pack_fseek(in_file, -nbytes) != 0) {
 		/* what if we need to be at the very beginning? */
 		nbytes--;
-		if (fseek(in_file, -nbytes, SEEK_CUR) != 0) return GETHDR_ERR;
+		if (-nbytes < 0) abort();
+		if (pack_fseek(in_file, -nbytes) != 0) return GETHDR_ERR;
 	}
 	return 0;
 }
@@ -258,8 +266,9 @@
 #ifdef LINUX_REALTIME
         return prefetch_get_input(bp,size);
 #else /* LINUX_REALTIME */
-	if ( fread( bp , 1, size, in_file) != size) 
-                if (feof(in_file)) return GETHDR_EOF;
+	/* LibAmp: PACKFILE input (VERIFIED 0x080e4de0) */
+	if ( pack_fread( bp , size, in_file) != size) 
+                if (pack_feof(in_file)) return GETHDR_EOF;
                 else return GETHDR_ERR;
 	return 0;
 #endif /* LINUX_REALTIME */
