  G --> H[load fonts f-4x6, f-6x9]
  H --> I[GameLoadSystem: data/system.def, system.sff, system.snd, motif fonts]
  I --> J[GameLoadFightData: fight.def, fight.sff, fight.snd, fightfx.sff/.air, common.snd, num1/name1 fonts]
  J --> K[select.def -> CharInfoInit / FindCharacters]
  K --> L[Precache: chars/kfm/kfm.def, kfm.sff, stages/kfm.def ...]
  L --> M[PlayCutscene logo / IntroScreen]
  M --> N[MainLoop: ModeSelect -> CharacterSelectScreen -> VersusScreen -> GamePlay/GameLoop]
